{
  "name": "dsh-chatgpt-prompt-autocomplete",
  "version": "1.0.0",
  "description": "DeepSeek Harness 输入框提示词自动补全：候选面板随输入更新，Tab 采纳、↑/↓ 切换、Esc 关闭；纯前端规则补全，不发起模型请求。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "chatgpt",
    "autocomplete",
    "prompt-completion"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhugang-hub/dsh-chatgpt-prompt-autocomplete.git"
  },
  "homepage": "https://github.com/zhugang-hub/dsh-chatgpt-prompt-autocomplete#readme",
  "bugs": {
    "url": "https://github.com/zhugang-hub/dsh-chatgpt-prompt-autocomplete/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg"
  }
}
